{"$round":[1234.5678,{"$numberLong":"1"}]}	=> {"x":{"$numberDouble":"1234.6"}}
{"$trunc":[1234.5678,{"$numberLong":"1"}]}	=> {"x":{"$numberDouble":"1234.5"}}
{"$round":[{"$numberLong":"12345"},{"$numberLong":"1"}]}	=> {"x":{"$numberLong":"12345"}}
{"$round":[12345,{"$numberLong":"1"}]}	=> {"x":{"$numberInt":"12345"}}
{"$round":[{"$numberDecimal":"1234.5678"},{"$numberLong":"1"}]}	=> {"x":{"$numberDecimal":"1234.6"}}
{"$round":[1234.5678,1.5]}	!! 51082	precision argument to  $round must be a integral value
{"$trunc":[1234.5678,1.5]}	!! 51082	precision argument to  $trunc must be a integral value
{"$round":[{"$numberLong":"12345"},1.5]}	!! 51082	precision argument to  $round must be a integral value
{"$round":[12345,1.5]}	!! 51082	precision argument to  $round must be a integral value
{"$round":[{"$numberDecimal":"1234.5678"},1.5]}	!! 51082	precision argument to  $round must be a integral value
{"$round":[1234.5678,"x"]}	!! 16004	can't convert from BSON type string to long
{"$trunc":[1234.5678,"x"]}	!! 16004	can't convert from BSON type string to long
{"$round":[{"$numberLong":"12345"},"x"]}	!! 16004	can't convert from BSON type string to long
{"$round":[12345,"x"]}	!! 16004	can't convert from BSON type string to long
{"$round":[{"$numberDecimal":"1234.5678"},"x"]}	!! 16004	can't convert from BSON type string to long
{"$round":[1234.5678,"$n"]}	=> {"x":null}
{"$trunc":[1234.5678,"$n"]}	=> {"x":null}
{"$round":[{"$numberLong":"12345"},"$n"]}	=> {"x":null}
{"$round":[12345,"$n"]}	=> {"x":null}
{"$round":[{"$numberDecimal":"1234.5678"},"$n"]}	=> {"x":null}
{"$round":[2.5]}	=> {"x":{"$numberDouble":"2.0"}}
{"$round":[3.5]}	=> {"x":{"$numberDouble":"4.0"}}
{"$round":[-2.5]}	=> {"x":{"$numberDouble":"-2.0"}}
{"$round":[{"$numberDecimal":"2.5"}]}	=> {"x":{"$numberDecimal":"2"}}
{"$round":[{"$numberDecimal":"-3.5"}]}	=> {"x":{"$numberDecimal":"-4"}}
{"$trunc":[{"$numberDecimal":"-3.5"}]}	=> {"x":{"$numberDecimal":"-3"}}
{"$ceil":{"$numberDecimal":"-3.5"}}	=> {"x":{"$numberDecimal":"-3"}}
{"$floor":{"$numberDecimal":"-3.5"}}	=> {"x":{"$numberDecimal":"-4"}}
{"$ceil":{"$numberDecimal":"3.0001"}}	=> {"x":{"$numberDecimal":"4"}}
{"$log":[8]}	!! 16020	Expression $log takes exactly 2 arguments. 1 were passed in.
{"$log":[8,1]}	!! 28759	$log's base must be a positive number not equal to 1, but is 1
{"$log":[-8,2]}	!! 28758	$log's argument must be a positive number, but is -8
{"$log":[{"$numberDecimal":"8"},{"$numberDecimal":"-2"}]}	!! 28759	$log's base must be a positive number not equal to 1, but is -2
{"$divide":[{"$numberDecimal":"1"},0]}	!! 2	can't $divide by zero
{"$divide":[1,{"$numberDecimal":"0"}]}	!! 2	can't $divide by zero
{"$divide":[{"$numberLong":"1"},3]}	=> {"x":{"$numberDouble":"0.3333333333333333"}}
